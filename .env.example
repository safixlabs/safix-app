# Copy to .env.local and fill in. Every value here is public: it ships in the
# browser bundle. Nothing secret belongs in this file.

# Which chain the app talks to: testnet (default), mainnet, or local.
NEXT_PUBLIC_CHAIN=testnet

# WalletConnect v2. Create a project at https://cloud.reown.com and paste its id
# here. Without it the app still works through browser wallets, but phone
# wallets and any browser without an extension have no way in.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Origin this app is served from, used for the WalletConnect session metadata
# and the wallet icon shown in the approval sheet. Falls back to the browser's
# own origin when unset.
NEXT_PUBLIC_APP_URL=

# Deployed contract addresses. With the pool and USDG set, the screens switch
# from demo data to live onchain reads and writes.
NEXT_PUBLIC_POOL_ADDRESS=
NEXT_PUBLIC_USDG_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_DESK_ADDRESS=

# Collateral tokens offered on the borrow screen.
NEXT_PUBLIC_ASSET_TBILL=
NEXT_PUBLIC_ASSET_BNVDA=
NEXT_PUBLIC_ASSET_TGOLD=

# Optional RPC endpoints tried ahead of the chain's public one, in order.
NEXT_PUBLIC_RPC_OVERRIDE=
NEXT_PUBLIC_RPC_FALLBACK=
